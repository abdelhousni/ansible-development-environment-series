# A stand-in for a RHEL 9 VM: Rocky Linux 9, booted with systemd.
FROM docker.io/rockylinux/rockylinux:9@sha256:8101994123cf3d0a8fee517bee7f39e555c7d92bd2d9eb3303cc988a0eeed00f

# The image strips file capabilities. Reinstalling restores the ones that
# newuidmap and newgidmap (shadow-utils) need for rootless Podman, and the one
# that lets PAM's unix_chkpwd (pam) read /etc/shadow, which systemd needs to
# start a lingering user's session. A RHEL 9 VM has them already.
RUN dnf -y install systemd procps-ng sudo python3 \
 && dnf -y reinstall shadow-utils pam \
 && dnf clean all \
 && useradd alice \
 && useradd bob

CMD ["/usr/sbin/init"]
